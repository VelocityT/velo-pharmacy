# ══════════════════════════════════════════════════════════════
#  Copy this to  .env  IN THIS FOLDER (the repository root).
#
#  One file for the whole monorepo. Prisma CLI reads it because the
#  npm scripts run from here; both Next apps read it because their
#  next.config.ts explicitly loads it. Do not create a second .env
#  inside apps/ — they will drift and you will chase phantom bugs.
# ══════════════════════════════════════════════════════════════

# CLOUD | ONPREM_SERVER | EDGE_COUNTER
NODE_MODE=CLOUD
NODE_KEY=CLOUD

# ── Database ──────────────────────────────────────────────────
# Two URLs, always:
#   DATABASE_URL  pooled   — app queries (serverless opens a
#                            connection per cold start)
#   DIRECT_URL    unpooled — migrations only (Prisma Migrate needs
#                            prepared statements, which a transaction
#                            pooler does not support)
#
# SUPABASE — from the dashboard's "Connect" button:
#   DATABASE_URL = "Transaction pooler", port 6543, + ?pgbouncer=true
#   DIRECT_URL   = "Session pooler",     port 5432
#   NOT the "Direct connection" string — it is IPv6-only for projects
#   created after Jan 2024 and most Indian ISPs are IPv4-only.
#
# ⚠ PERCENT-ENCODE SPECIAL CHARACTERS IN THE PASSWORD.
#   A raw "/" ends the host section and the URL silently parses wrong;
#   you get an authentication error that looks like a bad password.
#     /  →  %2F      $  →  %24      @  →  %40
#     #  →  %23      ?  →  %3F      :  →  %3A      %  →  %25
#   Simplest fix: use an alphanumeric database password and skip all
#   of this. Supabase → Settings → Database → Reset password.
#
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────
# REQUIRED, 32+ characters. The app refuses to boot without it —
# there is no fallback value, deliberately.
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#   bash:       openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=12h

# ── Sync ──────────────────────────────────────────────────────
SYNC_ENABLED=false
SYNC_PEER_URL=
SYNC_NODE_TOKEN=
SYNC_INTERVAL_MS=30000

# Document numbers reserved per block for offline billing
SEQUENCE_BLOCK_SIZE=1000
