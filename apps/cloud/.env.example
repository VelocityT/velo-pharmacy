# ══ VELOCARE PHARMACY CLOUD ═════════════════════════════════════
NODE_MODE=CLOUD
NODE_KEY=CLOUD

# Two URLs, always. DATABASE_URL is pooled (app queries on serverless);
# DIRECT_URL is unpooled (migrations only — Prisma Migrate cannot run
# through a transaction pooler).
#
# ── SUPABASE ──────────────────────────────────────────────────
# DATABASE_URL = "Transaction pooler", port 6543. The ?pgbouncer=true
#   flag is REQUIRED — without it you get
#   'prepared statement "s0" already exists' on the second request.
# DIRECT_URL   = "Session pooler", port 5432 — NOT the "Direct
#   connection" string. Supabase direct is IPv6-only for projects
#   created after Jan 2024, and most Indian ISPs are IPv4-only, so it
#   fails with 'Connection refused'. Session pooler returns IPv4.
#
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
#
# ── NEON ──────────────────────────────────────────────────────
# DATABASE_URL = the string containing "-pooler"
# DIRECT_URL   = same string with connection pooling toggled off
#
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/velocare?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/velocare?sslmode=require"

JWT_SECRET=""            # REQUIRED, 32+ chars. Generate: openssl rand -base64 48
JWT_EXPIRES_IN=12h

SYNC_ENABLED=false
SEQUENCE_BLOCK_SIZE=1000
