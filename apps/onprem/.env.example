# ══ VELOCARE PHARMACY SERVER — on-premise edition ═══════════════
# Runs entirely inside the hospital. No internet required, ever.
NODE_MODE=ONPREM_SERVER
NODE_KEY=HOSP-SERVER

DB_PASSWORD=change_this_on_install
DATABASE_URL="postgresql://velocare:change_this_on_install@db:5432/velocare_pharmacy?schema=public"
# No pooler on-premise — same as DATABASE_URL. Prisma requires it to be set.
DIRECT_URL="postgresql://velocare:change_this_on_install@db:5432/velocare_pharmacy?schema=public"

JWT_SECRET=""            # REQUIRED, 32+ chars. Generate per install, never ship a default.
JWT_EXPIRES_IN=12h

# Optional paid add-on: nightly encrypted push to the cloud for an
# owner dashboard + off-site backup. This is the upsell path from
# the on-prem licence to the SaaS subscription.
SYNC_ENABLED=false
SYNC_PEER_URL=
SYNC_NODE_TOKEN=

SEQUENCE_BLOCK_SIZE=1000
